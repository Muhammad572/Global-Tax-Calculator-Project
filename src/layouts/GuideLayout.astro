---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AdSlot from "@/components/AdSlot.astro";
import { SITE } from "@/data/site";

interface Props {
  title: string; // H1
  metaTitle?: string; // <title> (defaults to title)
  description: string;
  slug: string;
  updated: string; // ISO date
  jsonLd?: Record<string, unknown>[];
}
const { title, metaTitle, description, slug, updated, jsonLd = [] } = Astro.props;

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: updated,
  dateModified: updated,
  author: { "@type": "Organization", name: SITE.name },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: new URL(`/guides/${slug}/`, SITE.url).href,
};
---

<BaseLayout
  title={metaTitle ?? title}
  description={description}
  path={`/guides/${slug}/`}
  ogType="article"
  jsonLd={[article, ...jsonLd]}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Guides", href: "/guides/" },
        { label: title },
      ]}
    />
    <article class="prose guide">
      <header class="guide__head">
        <p class="eyebrow">Guide</p>
        <h1>{title}</h1>
        <p class="guide__meta">
          Updated <time datetime={updated}>{new Date(updated).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        </p>
      </header>
      <slot />
      <AdSlot placement="in-content" />
    </article>
  </div>
</BaseLayout>

<style>
  .guide {
    margin-top: 1.25rem;
  }
  .guide__head {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .guide__head h1 {
    margin-top: 0.4rem;
  }
  .guide__meta {
    color: var(--ink-faint);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .guide :global(h2) {
    margin-top: 2.25rem;
  }
  .guide :global(h2)::before {
    content: "";
    display: block;
    width: 2rem;
    height: 3px;
    margin-bottom: 0.75rem;
    border-radius: 2px;
    background: var(--accent-gradient);
  }
</style>
