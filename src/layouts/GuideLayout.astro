---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AdSlot from "@/components/AdSlot.astro";
import { SITE } from "@/data/site";
import { GUIDES_BY_SLUG } from "@/data/guides";

interface Props {
  title: string; // H1
  metaTitle?: string; // <title> (defaults to title)
  description: string;
  slug: string;
  updated: string; // ISO date
  jsonLd?: Record<string, unknown>[];
}
const { title, metaTitle, description, slug, updated, jsonLd = [] } = Astro.props;

const self = GUIDES_BY_SLUG[slug];
const relatedGuides = (self?.related ?? [])
  .map((s) => GUIDES_BY_SLUG[s])
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: updated,
  dateModified: updated,
  author: { "@type": "Organization", name: SITE.name },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: new URL(`/guides/${slug}/`, SITE.url).href,
};
---

<BaseLayout
  title={metaTitle ?? title}
  description={description}
  path={`/guides/${slug}/`}
  ogType="article"
  jsonLd={[article, ...jsonLd]}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Guides", href: "/guides/" },
        { label: title },
      ]}
    />
    <article class="prose guide">
      <header class="guide__head">
        <p class="eyebrow">Guide</p>
        <h1>{title}</h1>
        <p class="guide__meta">
          Updated <time datetime={updated}>{new Date(updated).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        </p>
      </header>
      <slot />

      {
        relatedGuides.length > 0 && (
          <nav class="guide__related" aria-label="Related guides">
            <h2>Related guides</h2>
            <ul>
              {relatedGuides.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}/`}>{g.title}</a> — {g.summary}
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <AdSlot placement="in-content" />
    </article>
  </div>
</BaseLayout>

<style>
  .guide {
    margin-top: 1.25rem;
  }
  .guide__head {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .guide__head h1 {
    margin-top: 0.4rem;
  }
  .guide__meta {
    color: var(--ink-faint);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .guide :global(h2) {
    margin-top: 2.25rem;
  }
  .guide :global(h2)::before {
    content: "";
    display: block;
    width: 2rem;
    height: 3px;
    margin-bottom: 0.75rem;
    border-radius: 2px;
    background: var(--accent-gradient);
  }
  .guide__related {
    margin-top: 2.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #ffffff, #fdfbf8);
    box-shadow: var(--shadow-card), var(--shadow-inset);
  }
  .guide__related h2 {
    margin-top: 0;
    font-size: 1.05rem;
  }
  .guide__related h2::before {
    display: none;
  }
  .guide__related ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
  }
</style>
