---
import "@/styles/tokens.css";
import "@/styles/fonts.css";
import "@/styles/decor.css";
import "@/styles/base.css";
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeadAnalytics from "@/components/HeadAnalytics.astro";
import ConsentAndAnalytics from "@/components/ConsentAndAnalytics.astro";
import { SITE } from "@/data/site";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path, noindex, ogType, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      GitHub Pages cannot set HTTP response headers, so security policy is
      applied here via <meta> where the mechanism supports it. A nonce-based CSP
      is not possible with Astro static output + our inline consent script, so
      script-src / style-src keep 'unsafe-inline'; the policy still blocks
      scripts/frames/objects from unlisted origins. The allowlist covers Google
      Analytics and (for when ads are enabled) Google AdSense.
    */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://adservice.google.com https://www.google.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.google-analytics.com https://*.googletagmanager.com https://*.googlesyndication.com https://*.g.doubleclick.net https://*.google.com https://google.com https://*.adtrafficquality.google; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://*.googlesyndication.com https://*.adtrafficquality.google; worker-src 'self' blob:"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {/* Declares the AdSense publisher account for the dashboard site-add /
        review. Zero cost; the id is public and already in /ads.txt. Loading the
        ad script is a separate opt-in (SITE.adsenseVerification). */}
    <meta name="google-adsense-account" content={SITE.adsensePublisherId} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#ea580c" />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="theme-color" content="#f7f5f1" />
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    <HeadAnalytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentAndAnalytics />
  </body>
</html>
