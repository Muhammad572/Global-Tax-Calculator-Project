---
interface QA {
  q: string;
  a: string; // plain text or simple HTML (kept inline; no scripts)
}
interface Props {
  items: QA[];
  heading?: string;
}
const { items, heading = "Frequently asked questions" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.a.replace(/<[^>]+>/g, "") },
  })),
};
---

<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">{heading}</h2>
  {
    items.map((it) => (
      <details>
        <summary>{it.q}</summary>
        <div set:html={it.a} />
      </details>
    ))
  }
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
