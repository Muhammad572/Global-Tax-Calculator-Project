---
import { SITE, FOOTER_LEGAL } from "@/data/site";
import { CLUSTERS, toolsInCluster } from "@/data/tools";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <a href="/" class="site-footer__brand" aria-label={`${SITE.name} home`}>
        <svg width="24" height="24" viewBox="0 0 26 26" aria-hidden="true">
          <rect x="1" y="1" width="24" height="24" rx="8" fill="url(#tt-fmark)" />
          <circle cx="13" cy="13" r="7.4" fill="none" stroke="#fff" stroke-width="2.1" />
          <path d="M13 8v5.2l3.6 2.1" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" />
          <defs>
            <linearGradient id="tt-fmark" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fb923c" />
              <stop offset="0.55" stop-color="#ea580c" />
              <stop offset="1" stop-color="#d97706" />
            </linearGradient>
          </defs>
        </svg>
        <span>{SITE.name}</span>
      </a>
      <p class="site-footer__tag">{SITE.tagline}</p>
    </div>

    <div class="site-footer__grid">
      {
        CLUSTERS.map((c) => (
          <nav class="site-footer__col" aria-label={c.label}>
            <p class="site-footer__title">{c.label}</p>
            <ul>
              {toolsInCluster(c.id).map((t) => (
                <li>
                  <a href={`/calculators/${t.slug}/`}>{t.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <nav class="site-footer__col" aria-label="Company">
        <p class="site-footer__title">Company</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/methodology/">Methodology &amp; Sources</a></li>
          {FOOTER_LEGAL.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="#" data-open-consent>Cookie settings</a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__base">
      <p class="site-footer__note">
        {SITE.name} provides free calculators for informational purposes only.
        Results are estimates, not financial, tax, or legal advice, and {SITE.name}
        is not affiliated with any government or tax authority. Pay and tax figures
        are withholding estimates — see the <a href="/disclaimer/">Disclaimer</a>.
      </p>
      <p class="site-footer__copy">© {year} {SITE.name} · {SITE.descriptor}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--border);
    background: var(--paper-sunk);
    padding-block: 2.75rem 2.5rem;
    margin-top: 4rem;
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-weight: 720;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.05rem;
  }
  .site-footer__tag {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.9rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.75rem 1.5rem;
  }
  .site-footer__title {
    margin: 0 0 0.55rem;
    font-size: 0.7rem;
    font-weight: 640;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  .site-footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.3rem;
  }
  .site-footer__col a {
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.12s ease;
  }
  .site-footer__col a:hover {
    color: var(--accent);
  }

  .site-footer__base {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .site-footer__note {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-faint);
    max-width: 68ch;
  }
  .site-footer__copy {
    margin-top: 0.65rem;
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
</style>
