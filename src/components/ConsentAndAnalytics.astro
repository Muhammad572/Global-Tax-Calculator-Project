---
/**
 * Google Consent Mode v2 + GA4 + (optional) AdSense loader, plus a lightweight
 * self-hosted consent banner.
 *
 * Behaviour:
 *  - Consent defaults to DENIED for ad_storage, ad_user_data, ad_personalization,
 *    analytics_storage. GA4 loads immediately but runs in cookieless "consent
 *    denied" ping mode until the visitor accepts.
 *  - The banner is shown to everyone (simple, one implementation for US/CA/UK/AU).
 *    "Accept" grants all; "Reject" keeps everything denied; choice persists in
 *    localStorage and is re-openable from the footer "Cookie settings" link.
 *  - AdSense's script is injected only after consent is granted AND
 *    SITE.adsenseEnabled is true.
 *
 * This is a good-faith implementation, not legal advice — see /privacy/.
 */
import { SITE } from "@/data/site";
const { ga4Id, adsensePublisherId } = SITE;
const adsenseEnabled = SITE.adsenseEnabled;
---

<script
  is:inline
  define:vars={{ ga4Id, adsensePublisherId, adsenseEnabled }}
>
  (function () {
    var STORAGE_KEY = "tt_consent_v1";
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    window.gtag = gtag;

    var granted = null;
    try {
      granted = localStorage.getItem(STORAGE_KEY);
    } catch (e) {
      /* storage blocked — treat as no choice */
    }

    var baseline = {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "granted",
      security_storage: "granted",
    };
    gtag("consent", "default", baseline);

    gtag("js", new Date());
    gtag("config", ga4Id, { anonymize_ip: true });

    function loadAds() {
      if (!adsenseEnabled || document.getElementById("tt-adsense")) return;
      var s = document.createElement("script");
      s.id = "tt-adsense";
      s.async = true;
      s.crossOrigin = "anonymous";
      s.src =
        "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" +
        adsensePublisherId;
      document.head.appendChild(s);
    }

    function apply(choice) {
      var v = choice === "granted" ? "granted" : "denied";
      gtag("consent", "update", {
        ad_storage: v,
        ad_user_data: v,
        ad_personalization: v,
        analytics_storage: v,
      });
      if (v === "granted") loadAds();
    }

    if (granted === "granted" || granted === "denied") {
      apply(granted);
    }

    window.__ttConsent = {
      set: function (choice) {
        try {
          localStorage.setItem(STORAGE_KEY, choice);
        } catch (e) {}
        apply(choice);
        var b = document.getElementById("tt-consent");
        if (b) b.hidden = true;
      },
      hasChoice: function () {
        return granted === "granted" || granted === "denied";
      },
    };
  })();
</script>
<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
></script>

<div id="tt-consent" class="consent" role="dialog" aria-label="Cookie consent" aria-live="polite" hidden>
  <p class="consent__text">
    We use cookies for analytics and, later, advertising. You can accept or reject
    non-essential cookies. See our <a href="/privacy/">Privacy Policy</a>.
  </p>
  <div class="consent__actions">
    <button type="button" class="btn" data-consent="denied">Reject</button>
    <button type="button" class="btn btn--primary" data-consent="granted">Accept</button>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById("tt-consent");
    if (!banner) return;
    if (!window.__ttConsent || !window.__ttConsent.hasChoice()) banner.hidden = false;
    banner.addEventListener("click", function (e) {
      var t = e.target;
      if (t && t.dataset && t.dataset.consent) {
        window.__ttConsent.set(t.dataset.consent);
      }
    });
    document.addEventListener("click", function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('[data-open-consent]')) {
        e.preventDefault();
        banner.hidden = false;
      }
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    inset: auto 0.75rem 0.75rem 0.75rem;
    z-index: 90;
    max-width: 32rem;
    margin-inline: auto;
    background: var(--paper-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.14);
    padding: 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .consent__text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .consent__actions {
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
  }
  .consent__actions .btn {
    min-height: 40px;
  }
</style>
