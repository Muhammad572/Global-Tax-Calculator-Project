---
/**
 * The consent banner UI + its DOM wiring. The Consent Mode v2 bootstrap, the
 * gtag.js / adsbygoogle.js tags, and the `window.__ttConsent` API all live in
 * src/components/HeadAnalytics.astro (rendered in <head>). This component is
 * rendered at the end of <body>.
 *
 *  - Consent defaults to DENIED for ad_storage, ad_user_data, ad_personalization,
 *    analytics_storage (set in HeadAnalytics before any Google tag).
 *  - "Accept" grants all; "Reject" keeps all denied. Choice persists in
 *    localStorage and is re-openable from the footer "Cookie settings" link.
 *
 * Good-faith implementation, not legal advice — see /privacy/.
 */
---

<div id="tt-consent" class="consent" role="dialog" aria-modal="false" aria-label="Cookie preferences" hidden data-consent>
  <div class="consent__inner">
    <p class="consent__text">
      We use cookies for analytics and, later, advertising. Calculator inputs
      stay in your browser. See our <a href="/privacy/">Privacy&nbsp;Policy</a>.
    </p>
    <div class="consent__actions">
      <button type="button" class="btn consent__btn" data-consent-choice="denied">Reject</button>
      <button type="button" class="btn btn--primary consent__btn" data-consent-choice="granted">Accept</button>
    </div>
  </div>
</div>

<script>
  import { initConsent } from "@/islands/consent";
  initConsent();
</script>

<style>
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    padding: 0.85rem;
    background: var(--paper-overlay);
    border-top: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .consent[hidden] { display: none; }
  .consent__inner {
    max-width: var(--wide-width);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .consent__text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    flex: 1 1 20rem;
  }
  .consent__actions {
    display: flex;
    gap: 0.6rem;
    flex: 0 0 auto;
  }
  .consent__btn {
    min-height: 42px;
    padding-inline: 1.15rem;
  }
  @media (max-width: 32rem) {
    .consent__actions { width: 100%; }
    .consent__btn { flex: 1; }
  }
</style>
