---
import type { ClusterId } from "@/data/tools";
interface Props {
  id: ClusterId;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<span class:list={["clusticon", className]} aria-hidden="true">
  {
    id === "work-hours" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="13" r="8" />
        <path d="M12 9v4l2.5 1.5M9 2h6" />
      </svg>
    )
  }
  {
    id === "overtime" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7v5l3 2" />
        <path d="M20.5 5.5 22 4M3.5 5.5 2 4" />
      </svg>
    )
  }
  {
    id === "pay-salary" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.5" y="6" width="19" height="12" rx="2.5" />
        <circle cx="12" cy="12" r="2.6" />
        <path d="M6 12h.01M18 12h.01" />
      </svg>
    )
  }
  {
    id === "paycheck" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 3h9l4 4v12.5a1.5 1.5 0 0 1-2.3 1.3L15 20l-1.7 1-1.6-1-1.7 1-1.6-1L6 21.8A1.5 1.5 0 0 1 3.7 20.5V4.5A1.5 1.5 0 0 1 5.2 3Z" />
        <path d="M8 8h6M8 11.5h8M8 15h5" />
      </svg>
    )
  }
</span>

<style>
  .clusticon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 10px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-wash) 80%, transparent);
    border: 1px solid var(--accent-line);
  }
  .clusticon svg {
    width: 1.3rem;
    height: 1.3rem;
  }
</style>
