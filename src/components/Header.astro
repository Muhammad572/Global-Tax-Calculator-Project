---
import { SITE } from "@/data/site";
import { CLUSTERS, toolsInCluster } from "@/data/tools";
const path = Astro.url.pathname;
const inCalculators = path.startsWith("/calculators/");
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand__mark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 26 26">
          <rect x="1" y="1" width="24" height="24" rx="8" fill="url(#tt-mark)" />
          <circle cx="13" cy="13" r="7.4" fill="none" stroke="#fff" stroke-width="2.1" />
          <path d="M13 8v5.2l3.6 2.1" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" />
          <defs>
            <linearGradient id="tt-mark" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fb923c" />
              <stop offset="0.55" stop-color="#ea580c" />
              <stop offset="1" stop-color="#d97706" />
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="brand__name">{SITE.name}</span>
      <span class="brand__descriptor">{SITE.descriptor}</span>
    </a>

    <nav class="site-nav" aria-label="Primary" data-nav>
      <a class="site-nav__link" href="/guides/" aria-current={isActive("/guides/") ? "page" : undefined}>Guides</a>
      <a class="site-nav__link" href="/about/" aria-current={isActive("/about/") ? "page" : undefined}>About</a>

      <details class="site-nav__menu">
        <summary
          class="site-nav__toggle"
          aria-label="Open the calculators menu"
          aria-expanded="false"
          aria-current={inCalculators ? "page" : undefined}
        >
          <span class="site-nav__toggle-label">Calculators</span>
          <svg class="site-nav__chevron" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3.5 5.25 7 8.75l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="site-nav__burger" aria-hidden="true"><i></i><i></i><i></i></span>
        </summary>

        <div class="site-nav__backdrop" data-nav-backdrop></div>

        <div class="site-nav__panel" role="group" aria-label="Site navigation">
          <div class="site-nav__panel-head">
            <span class="site-nav__panel-title">Navigate</span>
            <button type="button" class="site-nav__close" data-nav-close aria-label="Close menu">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4.5 4.5l9 9M13.5 4.5l-9 9" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
            </button>
          </div>

          <ul class="site-nav__primary">
            <li><a href="/calculators/" aria-current={path === "/calculators/" ? "page" : undefined}>All calculators</a></li>
            <li><a href="/guides/" aria-current={isActive("/guides/") ? "page" : undefined}>Guides</a></li>
            <li><a href="/about/" aria-current={isActive("/about/") ? "page" : undefined}>About</a></li>
          </ul>

          <div class="site-nav__mega">
            {
              CLUSTERS.map((c) => (
                <div class="site-nav__group">
                  <p class="site-nav__group-title">{c.label}</p>
                  <ul>
                    {toolsInCluster(c.id).map((t) => (
                      <li>
                        <a
                          href={`/calculators/${t.slug}/`}
                          aria-current={path === `/calculators/${t.slug}/` ? "page" : undefined}
                        >
                          {t.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <a class="site-nav__all" href="/calculators/">See all 11 calculators →</a>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  import { initNav } from "@/islands/nav";
  initNav();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100; /* owns the top stacking tier for the mobile sheet + backdrop */
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    /* Applied to a pseudo-element, NOT the header, so it doesn't create a
       containing block for the fixed mobile sheet. */
    .site-header::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      -webkit-backdrop-filter: saturate(1.7) blur(12px);
      backdrop-filter: saturate(1.7) blur(12px);
    }
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--ink);
    text-decoration: none;
    font-weight: 720;
    letter-spacing: -0.02em;
  }
  .brand__mark {
    display: flex;
    filter: drop-shadow(0 4px 10px rgb(234 88 12 / 0.32));
  }
  .brand__name {
    font-size: 1.12rem;
  }
  .brand__descriptor {
    font-weight: 480;
    font-size: 0.8rem;
    color: var(--ink-faint);
    padding-left: 0.75ch;
    margin-left: 0.4ch;
    border-left: 1px solid var(--border-strong);
  }
  @media (max-width: 40rem) {
    .brand__descriptor { display: none; }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Inline desktop links */
  .site-nav__link {
    display: none;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-sm);
    font-weight: 540;
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .site-nav__link:hover {
    color: var(--ink);
    background: var(--paper-sunk);
  }
  .site-nav__link[aria-current="page"] {
    color: var(--ink);
  }
  @media (min-width: 48rem) {
    .site-nav__link {
      display: inline-block;
    }
  }

  /* Toggle ----------------------------------------------------------- */
  .site-nav__menu {
    position: static;
  }
  .site-nav__toggle {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    min-height: 40px;
    padding: 0 0.75rem 0 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
    font-weight: 560;
    font-size: 0.95rem;
    box-shadow: var(--shadow-inset);
    transition: background-color 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease;
  }
  .site-nav__toggle:hover {
    background: var(--paper-sunk);
  }
  .site-nav__menu[open] .site-nav__toggle {
    border-color: var(--accent-line);
    box-shadow: var(--focus);
  }
  .site-nav__toggle::-webkit-details-marker {
    display: none;
  }
  .site-nav__chevron {
    display: none;
    transition: transform 0.2s ease;
    color: var(--ink-faint);
  }
  .site-nav__menu[open] .site-nav__chevron {
    transform: rotate(180deg);
  }
  .site-nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 3.5px;
    width: 15px;
    height: 15px;
  }
  .site-nav__burger i {
    display: block;
    height: 2px;
    width: 100%;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.14s ease;
    transform-origin: center;
  }
  .site-nav__menu[open] .site-nav__burger i:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .site-nav__menu[open] .site-nav__burger i:nth-child(2) { opacity: 0; }
  .site-nav__menu[open] .site-nav__burger i:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  @media (min-width: 48rem) {
    .site-nav__toggle-label { order: 0; }
    .site-nav__chevron { display: inline-block; }
    .site-nav__burger { display: none; }
  }
  @media (max-width: 47.999rem) and (max-width: 26rem) {
    .site-nav__toggle-label { display: none; }
    .site-nav__toggle { padding-inline: 0.6rem; }
  }

  /* Backdrop (mobile) --------------------------------------------- */
  .site-nav__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(6 8 14 / 0.6);
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .site-nav__menu[open] .site-nav__backdrop {
    display: block;
    opacity: 1;
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-nav__menu[open] .site-nav__backdrop {
      -webkit-backdrop-filter: blur(3px);
      backdrop-filter: blur(3px);
    }
  }

  /* Panel — mobile: right sheet -------------------------------- */
  .site-nav__panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: min(22rem, 90vw);
    padding: 1rem 1.1rem 2.5rem;
    background: var(--paper-overlay);
    border-left: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(101%);
    transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
    display: grid;
    align-content: start;
    gap: 1.1rem;
  }
  .site-nav__menu[open] .site-nav__panel {
    transform: translateX(0);
  }

  .site-nav__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-nav__panel-title {
    font-size: 0.7rem;
    font-weight: 620;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .site-nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .site-nav__close:hover { background: var(--paper-sunk); color: var(--ink); }

  .site-nav__primary {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0 0 0.9rem;
    border-bottom: 1px solid var(--border);
    list-style: none;
  }
  .site-nav__primary a {
    display: block;
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .site-nav__primary a:hover { background: var(--paper-sunk); }
  .site-nav__primary a[aria-current="page"] { color: var(--accent); background: var(--accent-wash); }

  .site-nav__mega {
    display: grid;
    gap: 1.1rem 1.5rem;
  }
  .site-nav__group-title {
    margin: 0 0 0.4rem;
    padding-left: 0.65rem;
    font-size: 0.68rem;
    font-weight: 640;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .site-nav__group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.05rem;
  }
  .site-nav__group a {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--ink-soft);
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .site-nav__group a:hover { background: var(--paper-sunk); color: var(--ink); }
  .site-nav__group a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
    background: var(--accent-wash);
  }
  .site-nav__all {
    grid-column: 1 / -1;
    font-size: 0.88rem;
    font-weight: 560;
    text-decoration: none;
    color: var(--accent);
    padding: 0.35rem 0.65rem;
  }
  .site-nav__all:hover { text-decoration: underline; }

  /* Desktop: dropdown card -------------------------------------- */
  @media (min-width: 48rem) {
    .site-nav__menu { position: relative; }
    .site-nav__backdrop,
    .site-nav__panel-head,
    .site-nav__primary { display: none; }
    .site-nav__panel {
      position: absolute;
      inset: auto 0 auto auto;
      top: calc(100% + 0.6rem);
      width: min(53rem, calc(100vw - 2.5rem));
      height: auto;
      max-height: min(34rem, calc(100dvh - var(--header-h) - 2rem));
      padding: 1.3rem 1.4rem;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      transform: translateY(-8px) scale(0.985);
      transform-origin: top right;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.16s ease, transform 0.18s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .site-nav__menu[open] .site-nav__panel {
      transform: translateY(0) scale(1);
      opacity: 1;
      pointer-events: auto;
    }
    .site-nav__mega {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__panel,
    .site-nav__backdrop,
    .site-nav__burger i,
    .site-nav__chevron { transition: none; }
  }
</style>
