---
import { SITE, PRIMARY_NAV } from "@/data/site";
import { CLUSTERS, toolsInCluster } from "@/data/tools";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
const inCalculators = path.startsWith("/calculators/");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <svg class="brand__glyph" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor" />
        <circle cx="12" cy="12" r="7" fill="none" stroke="var(--accent-ink)" stroke-width="2" />
        <path d="M12 7.5v5l3.4 2" fill="none" stroke="var(--accent-ink)" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span class="brand__name">{SITE.name}</span>
      <span class="brand__descriptor">{SITE.descriptor}</span>
    </a>

    <nav class="site-nav" aria-label="Primary" data-nav>
      <details class="site-nav__menu">
        <summary class="site-nav__toggle" aria-label="Open menu" aria-expanded="false">
          <span class="site-nav__toggle-label">Menu</span>
          <span class="site-nav__burger" aria-hidden="true"><i></i><i></i><i></i></span>
        </summary>

        <div class="site-nav__backdrop" data-nav-backdrop></div>

        <div class="site-nav__panel" role="group" aria-label="Site navigation">
          <div class="site-nav__panel-head">
            <span class="site-nav__panel-title">Navigate</span>
            <button type="button" class="site-nav__close" data-nav-close aria-label="Close menu">
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>

          <ul class="site-nav__primary">
            {
              PRIMARY_NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      isActive(item.href) || (item.href === "/calculators/" && inCalculators) ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="site-nav__mega">
            {
              CLUSTERS.map((c) => (
                <div class="site-nav__group">
                  <p class="site-nav__group-title">{c.label}</p>
                  <ul>
                    {toolsInCluster(c.id).map((t) => (
                      <li>
                        <a
                          href={`/calculators/${t.slug}/`}
                          aria-current={path === `/calculators/${t.slug}/` ? "page" : undefined}
                        >
                          {t.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  import { initNav } from "@/islands/nav";
  initNav();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    /* The header owns the top stacking tier so the mobile menu sheet + backdrop
       (its descendants) sit above the fixed consent banner. No backdrop-filter /
       transform here — those would create a containing block that collapses the
       fixed sheet to header height. */
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55ch;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .brand__glyph {
    color: var(--accent);
    flex: none;
    border-radius: 7px;
  }
  .brand__name {
    font-size: 1.1rem;
  }
  .brand__descriptor {
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--ink-faint);
    padding-left: 0.7ch;
    margin-left: 0.35ch;
    border-left: 1px solid var(--border-strong);
  }
  @media (max-width: 34rem) {
    .brand__descriptor { display: none; }
  }

  /* Toggle -------------------------------------------------------------- */
  .site-nav__menu {
    position: static;
  }
  .site-nav__toggle {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.55ch;
    min-height: 40px;
    padding: 0 0.7rem 0 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
    font-weight: 560;
    font-size: 0.95rem;
    transition: background-color 0.14s ease, border-color 0.14s ease;
  }
  .site-nav__toggle:hover {
    background: var(--paper-sunk);
  }
  .site-nav__toggle::-webkit-details-marker {
    display: none;
  }
  .site-nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 3.5px;
    width: 16px;
    height: 16px;
  }
  .site-nav__burger i {
    display: block;
    height: 2px;
    width: 100%;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.15s ease;
    transform-origin: center;
  }
  .site-nav__menu[open] .site-nav__burger i:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .site-nav__menu[open] .site-nav__burger i:nth-child(2) {
    opacity: 0;
  }
  .site-nav__menu[open] .site-nav__burger i:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }
  @media (max-width: 30rem) {
    .site-nav__toggle-label { display: none; }
    .site-nav__toggle { padding-inline: 0.6rem; }
  }

  /* Backdrop (mobile) -------------------------------------------------- */
  .site-nav__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(8 11 18 / 0.55);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .site-nav__menu[open] .site-nav__backdrop {
    display: block;
    opacity: 1;
  }

  /* Panel — mobile: right sheet -------------------------------------- */
  .site-nav__panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: min(21rem, 88vw);
    padding: 0.9rem 1rem 2rem;
    background: var(--paper-overlay);
    border-left: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 0.24s cubic-bezier(0.32, 0.72, 0, 1);
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .site-nav__menu[open] .site-nav__panel {
    transform: translateX(0);
  }

  .site-nav__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-nav__panel-title {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .site-nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .site-nav__close:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  .site-nav__primary {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0 0 0.85rem;
    border-bottom: 1px solid var(--border);
    list-style: none;
  }
  .site-nav__primary a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .site-nav__primary a:hover {
    background: var(--paper-sunk);
  }
  .site-nav__primary a[aria-current="page"] {
    color: var(--accent);
    background: var(--accent-wash);
  }

  .site-nav__mega {
    display: grid;
    gap: 1rem 1.25rem;
  }
  .site-nav__group-title {
    margin: 0 0 0.35rem;
    padding-left: 0.6rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .site-nav__group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.05rem;
  }
  .site-nav__group a {
    display: block;
    padding: 0.42rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .site-nav__group a:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }
  .site-nav__group a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
    background: var(--accent-wash);
  }

  /* Desktop: dropdown card ----------------------------------------- */
  @media (min-width: 48rem) {
    .site-nav__menu {
      position: relative;
    }
    .site-nav__backdrop,
    .site-nav__panel-head {
      display: none;
    }
    .site-nav__panel {
      position: absolute;
      inset: auto 0 auto auto;
      top: calc(100% + 0.55rem);
      width: min(52rem, calc(100vw - 2rem));
      height: auto;
      max-height: min(34rem, calc(100vh - var(--header-h) - 2rem));
      padding: 1.1rem 1.3rem 1.3rem;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      transform: translateY(-6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.16s ease, transform 0.16s ease;
    }
    .site-nav__menu[open] .site-nav__panel {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .site-nav__primary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 0.5rem;
    }
    .site-nav__mega {
      grid-template-columns: repeat(4, 1fr);
      margin-top: 0.95rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .site-nav__panel,
    .site-nav__backdrop,
    .site-nav__burger i {
      transition: none;
    }
  }
</style>
