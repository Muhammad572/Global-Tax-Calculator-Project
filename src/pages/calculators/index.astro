---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AdSlot from "@/components/AdSlot.astro";
import { SITE } from "@/data/site";
import { CLUSTERS, toolsInCluster } from "@/data/tools";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: CLUSTERS.flatMap((c) =>
    toolsInCluster(c.id).map((t) => ({
      "@type": "ListItem",
      name: t.title,
      url: new URL(`/calculators/${t.slug}/`, SITE.url).href,
    })),
  ).map((x, i) => ({ ...x, position: i + 1 })),
};
---

<BaseLayout
  title="All Calculators"
  description="Every TinyTools calculator for work hours and pay: time card, hours worked, time clock, working hours, time, decimal hours, overtime, salary to hourly, hourly pay, paycheck, and take-home pay."
  path="/calculators/"
  jsonLd={[itemList]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Calculators" }]} />
    <header class="hub-head">
      <p class="eyebrow">The full toolkit</p>
      <h1>All calculators</h1>
      <p class="lead">
        Eleven calculators, grouped by the problem they solve. Each one works
        offline in your browser and shows how the result is calculated.
      </p>
    </header>

    <AdSlot placement="top-leaderboard" />

    {
      CLUSTERS.map((c) => (
        <section class="cat">
          <h2>{c.label}</h2>
          <p class="cat__blurb">{c.blurb}</p>
          <ul class="cat__list">
            {toolsInCluster(c.id).map((t) => (
              <li>
                <a href={`/calculators/${t.slug}/`}>
                  <span class="cat__name">{t.title}</span>
                  <span class="cat__desc">{t.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="prose choose">
      <h2>Which one do I need?</h2>
      <ul>
        <li><strong>I have start and end times for one shift</strong> &rarr; <a href="/calculators/hours-worked-calculator/">Hours Worked Calculator</a>.</li>
        <li><strong>I have a whole week of shifts with breaks</strong> &rarr; <a href="/calculators/time-card-calculator/">Time Card Calculator</a>.</li>
        <li><strong>I have a column of clock-in / clock-out punches</strong> &rarr; <a href="/calculators/time-clock-calculator/">Time Clock Calculator</a>.</li>
        <li><strong>I just need to add or subtract times</strong> (no pay) &rarr; <a href="/calculators/time-calculator/">Time Calculator</a>.</li>
        <li><strong>I need to turn minutes into decimal hours</strong> &rarr; <a href="/calculators/decimal-hours-calculator/">Decimal Hours Calculator</a>.</li>
        <li><strong>I want hours per week / month / year and FTE</strong> &rarr; <a href="/calculators/working-hours-calculator/">Working Hours Calculator</a>.</li>
        <li><strong>I want the overtime split on my hours</strong> &rarr; <a href="/calculators/overtime-calculator/">Overtime Calculator</a>.</li>
        <li><strong>I have an hourly rate and want weekly / annual pay</strong> &rarr; <a href="/calculators/hourly-pay-calculator/">Hourly Pay Calculator</a>.</li>
        <li><strong>I want to convert a salary to an hourly rate (or back)</strong> &rarr; <a href="/calculators/salary-to-hourly-calculator/">Salary to Hourly Calculator</a>.</li>
        <li><strong>I want an estimate of one paycheck after tax</strong> &rarr; <a href="/calculators/paycheck-calculator/">Paycheck Calculator</a>.</li>
        <li><strong>I want annual take-home from a salary</strong> &rarr; <a href="/calculators/take-home-pay-calculator/">Take-Home Pay Calculator</a>.</li>
      </ul>

      <h2>How they work</h2>
      <p>
        Every calculator runs on one shared, unit-tested calculation engine, so
        the same inputs always produce the same result. Nothing you enter leaves
        your browser — see the <a href="/privacy/">Privacy Policy</a>. Hours and
        overtime arithmetic is exact; pay and tax figures are withholding
        <em>estimates</em> for {SITE.markets.join(", ")}, with US tax coverage
        limited to federal, FICA, and a defined set of states for 2026. Where a
        jurisdiction is not modelled the tool says so. Full detail is on the
        <a href="/methodology/">Methodology &amp; Sources</a> page, and the
        <a href="/guides/">guides</a> explain the rules behind each result.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .choose {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .hub-head {
    margin-bottom: 1.5rem;
  }
  .hub-head h1 {
    margin-top: 0.4rem;
  }
  .lead {
    max-width: 58ch;
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
  .cat {
    margin-top: 2.75rem;
  }
  .cat > h2 {
    margin-top: 0;
  }
  .cat__blurb {
    margin-top: 0.2rem;
    color: var(--ink-faint);
  }
  .cat__list {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .cat__list a {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #ffffff, #fdfbf8);
    text-decoration: none;
    box-shadow: var(--shadow-card), var(--shadow-inset);
    overflow: hidden;
    transition: transform 0.14s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .cat__list a::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent-gradient);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.18s ease;
  }
  .cat__list a:hover {
    border-color: var(--accent-line);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover), var(--shadow-inset);
  }
  .cat__list a:hover::after {
    transform: scaleY(1);
  }
  .cat__name {
    display: block;
    font-weight: 620;
    color: var(--ink);
  }
  .cat__desc {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.86rem;
    color: var(--ink-faint);
  }
</style>
