---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE } from "@/data/site";
import { GUIDES, GUIDES_BY_SLUG } from "@/data/guides";
import { TOOLS_BY_SLUG } from "@/data/tools";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: GUIDES.map((g, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: g.title,
    url: new URL(`/guides/${g.slug}/`, SITE.url).href,
  })),
};

const GROUPS: { title: string; blurb: string; slugs: string[] }[] = [
  {
    title: "Hours & timekeeping",
    blurb: "Turning clock times into paid hours, and the rules employers follow.",
    slugs: [
      "how-to-calculate-hours-worked",
      "how-time-cards-work",
      "time-clock-rounding-rules",
      "convert-minutes-to-decimal-hours",
    ],
  },
  {
    title: "Overtime",
    blurb: "The formula, the thresholds, and who is actually entitled to it.",
    slugs: [
      "how-to-calculate-overtime-pay",
      "what-is-double-time-pay",
      "exempt-vs-non-exempt-employees",
      "is-overtime-taxed-more",
    ],
  },
  {
    title: "Salary & a work year",
    blurb: "Converting between hourly and annual pay, and how many hours a year holds.",
    slugs: [
      "salary-vs-hourly-pay",
      "convert-hourly-wage-to-annual-salary",
      "how-many-work-hours-in-a-year",
      "what-is-full-time-equivalent",
    ],
  },
  {
    title: "Paycheck & deductions",
    blurb: "Why take-home is less than gross, and how to read what came out.",
    slugs: [
      "gross-pay-vs-take-home-pay",
      "how-to-read-a-pay-stub",
      "what-are-fica-taxes",
      "what-is-a-pay-period",
      "biweekly-vs-semimonthly-pay",
    ],
  },
];
---

<BaseLayout
  title="Guides"
  description="Short, accurate guides on calculating hours worked, overtime pay, time cards, salary vs hourly pay, gross vs take-home pay, and work hours in a year."
  path="/guides/"
  jsonLd={[itemList]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Guides" }]} />
    <header class="hub-head">
      <p class="eyebrow">Learn the rules</p>
      <h1>Guides</h1>
      <p class="lead">
        Plain explanations of how work-hours and pay calculations work — the
        rules, the formulas, and the edge cases. Each guide links to the
        calculator that does the maths for you and cites its primary source
        (US Department of Labor, IRS, state agencies) so you can check it.
      </p>
    </header>

    <div class="prose guides-note">
      <p>
        There are {GUIDES.length} guides, grouped below to match the four
        families of calculators. They are written for the US, with notes for
        Canada, the UK, and Australia where the rules differ. Everything here is
        general information, not legal or tax advice — see the
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </div>

    {
      GROUPS.map((grp) => (
        <section class="guide-group">
          <h2>{grp.title}</h2>
          <p class="guide-group__blurb">{grp.blurb}</p>
          <ul class="guide-list">
            {grp.slugs
              .map((s) => GUIDES_BY_SLUG[s])
              .filter(Boolean)
              .map((gm) => {
                const guide = gm!;
                return (
                  <li>
                    <a href={`/guides/${guide.slug}/`}>
                      <span class="guide-list__title">{guide.title}</span>
                      <span class="guide-list__summary">{guide.summary}</span>
                    </a>
                    <p class="guide-list__tools">
                      Related:{" "}
                      {guide.supports.map((s, i) => {
                        const t = TOOLS_BY_SLUG[s];
                        return t ? (
                          <>
                            {i > 0 ? ", " : ""}
                            <a href={`/calculators/${t.slug}/`}>{t.title}</a>
                          </>
                        ) : null;
                      })}
                    </p>
                  </li>
                );
              })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .hub-head { margin-bottom: 1.25rem; }
  .hub-head h1 { margin-top: 0.4rem; }
  .lead { max-width: 60ch; margin-top: 0.6rem; color: var(--ink-soft); font-size: 1.05rem; }
  .guides-note { max-width: 62ch; margin-bottom: 2.25rem; color: var(--ink-soft); }
  .guide-group { margin-top: 2.5rem; }
  .guide-group > h2 { margin: 0; font-size: 1.3rem; }
  .guide-group__blurb { margin: 0.25rem 0 0; color: var(--ink-faint); }
  .guide-list { margin-top: 1rem; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .guide-list > li {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #ffffff, #fdfbf8);
    box-shadow: var(--shadow-card), var(--shadow-inset);
    transition: transform 0.14s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .guide-list > li:hover {
    transform: translateY(-3px);
    border-color: var(--accent-line);
    box-shadow: var(--shadow-card-hover), var(--shadow-inset);
  }
  .guide-list a { text-decoration: none; }
  .guide-list__title {
    display: block;
    font-weight: 660;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .guide-list > li:hover .guide-list__title { color: var(--accent); }
  .guide-list__summary { display: block; margin-top: 0.25rem; color: var(--ink-soft); }
  .guide-list__tools { margin-top: 0.6rem; font-size: 0.85rem; color: var(--ink-faint); }
</style>
