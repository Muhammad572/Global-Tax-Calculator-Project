---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE } from "@/data/site";
import { GUIDES } from "@/data/guides";
import { TOOLS_BY_SLUG } from "@/data/tools";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: GUIDES.map((g, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: g.title,
    url: new URL(`/guides/${g.slug}/`, SITE.url).href,
  })),
};
---

<BaseLayout
  title="Guides"
  description="Short, accurate guides on calculating hours worked, overtime pay, time cards, salary vs hourly pay, gross vs take-home pay, and work hours in a year."
  path="/guides/"
  jsonLd={[itemList]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Guides" }]} />
    <header class="hub-head">
      <p class="eyebrow">Learn the rules</p>
      <h1>Guides</h1>
      <p class="lead">
        Plain explanations of how work-hours and pay calculations work — the rules,
        the formulas, and the edge cases. Each guide links to the calculator that
        does the maths for you.
      </p>
    </header>

    <ul class="guide-list">
      {
        GUIDES.map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`}>
              <span class="guide-list__title">{g.title}</span>
              <span class="guide-list__summary">{g.summary}</span>
            </a>
            <p class="guide-list__tools">
              Related:{" "}
              {g.supports.map((s, i) => {
                const t = TOOLS_BY_SLUG[s];
                return t ? (
                  <>
                    {i > 0 ? ", " : ""}
                    <a href={`/calculators/${t.slug}/`}>{t.title}</a>
                  </>
                ) : null;
              })}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .hub-head { margin-bottom: 1.75rem; }
  .hub-head h1 { margin-top: 0.4rem; }
  .lead { max-width: 58ch; margin-top: 0.6rem; color: var(--ink-soft); font-size: 1.05rem; }
  .guide-list { margin-top: 1.5rem; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .guide-list > li {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #ffffff, #fdfbf8);
    box-shadow: var(--shadow-card), var(--shadow-inset);
    transition: transform 0.14s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .guide-list > li:hover {
    transform: translateY(-3px);
    border-color: var(--accent-line);
    box-shadow: var(--shadow-card-hover), var(--shadow-inset);
  }
  .guide-list a { text-decoration: none; }
  .guide-list__title {
    display: block;
    font-weight: 660;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .guide-list > li:hover .guide-list__title { color: var(--accent); }
  .guide-list__summary { display: block; margin-top: 0.25rem; color: var(--ink-soft); }
  .guide-list__tools { margin-top: 0.6rem; font-size: 0.85rem; color: var(--ink-faint); }
</style>
