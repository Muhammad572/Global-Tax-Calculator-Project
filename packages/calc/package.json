{
  "name": "@tinytools/calc",
  "version": "0.1.0",
  "description": "Deterministic, UI-independent calculation engine for TinyTools work-hours and pay calculators.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
